{
  "name": "replybots",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:frontend": "./scripts/build-frontend.sh",
    "build:frontend:dev": "./scripts/build-frontend.sh dev",
    "build:docs": "node scripts/generate-docs-ref.mjs && mdbook build docs",
    "deploy": "./scripts/deploy.sh",
    "dev": "wrangler dev",
