legalPage : String -> List ( String, List String ) -> Html msg
legalPage title sections =
    div [ class "page page-legal" ]
        [ h1 [] [ text title ]
        , p [ class "muted" ] [ text "Last updated 22 November 2026." ]
        , div []
            (List.map
                (\( heading, paragraphs ) ->
                    section []
                        (h2 [] [ text heading ]
                            :: List.map (\body -> p [] [ text body ]) paragraphs
                        )
                )
                sections
            )
        ]
