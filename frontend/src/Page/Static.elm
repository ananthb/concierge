module Page.Static exposing (login, notFound, privacy, terms)

{-| Pages with no state of their own: the legal text, the sign-in screen, and
the 404.
-}

import Html exposing (Html, a, button, div, h1, h2, p, section, text)
import Html.Attributes exposing (class, disabled, type_)
import Html.Events exposing (onClick)
import Route
import Ui


login : { onLogin : msg, busy : Bool, error : Maybe String } -> Html msg
login opts =
    div [ class "page page-login" ]
        [ h1 [] [ text "Sign in to replybots" ]
        , p [ class "page-sub" ]
            [ text "Sign in with your WhatsApp Business account via Meta. There's no password to remember." ]
        , case opts.error of
            Just err ->
                Ui.banner "error" err

            Nothing ->
                text ""
        , button
            [ class "btn btn-primary btn-lg"
            , type_ "button"
            , disabled opts.busy
            , onClick opts.onLogin
            ]
            [ text
                (if opts.busy then
                    "Connecting…"

                 else
                    "Continue with WhatsApp"
                )
            ]
        , p [ class "fine-print" ]
            [ text "By signing in you agree to our "
            , a [ Route.href Route.Terms ] [ text "terms" ]
            , text " and "
            , a [ Route.href Route.Privacy ] [ text "privacy policy" ]
            , text "."
            ]
        ]


notFound : Html msg
notFound =
    div [ class "page page-404" ]
        [ h1 [] [ text "Nothing here" ]
        , p [] [ text "That page doesn't exist." ]
        , a [ Route.href Route.Landing, class "btn btn-secondary" ] [ text "Back to the start" ]
        ]


